rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function me() { return request.auth.uid; }

    // Profiles: any signed-in user can look people up by email; only you edit yours.
    match /users/{uid} {
      allow read: if signedIn();
      allow create, update: if signedIn() && uid == me()
        && request.resource.data.keys().hasOnly(['name', 'email', 'emailLower', 'updatedAt']);
    }

    match /chats/{chatId} {
      function isMember() { return signedIn() && me() in resource.data.members; }
      // resource == null lets the app check whether a direct chat exists before creating it.
      allow get: if signedIn() && (resource == null || me() in resource.data.members);
      allow list: if isMember();
      allow create: if signedIn()
        && request.resource.data.createdBy == me()
        && me() in request.resource.data.members
        && request.resource.data.type in ['direct', 'group']
        && (request.resource.data.type == 'group' || chatId.matches('dm_.*'));
      // Members can rename, add people, change the bot mode, and post. botTyping is set by the server only.
      allow update: if isMember()
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['createdBy', 'type', 'botTyping'])
        && (resource.data.type == 'group' || request.resource.data.members == resource.data.members);

      match /messages/{messageId} {
        function chatMember() {
          return signedIn() && me() in get(/databases/$(database)/documents/chats/$(chatId)).data.members;
        }
        allow read: if chatMember();
        // Only the Cloud Function (admin SDK) can write Librarian messages.
        allow create: if chatMember()
          && request.resource.data.senderId == me()
          && request.resource.data.type in ['text', 'system']
          && request.resource.data.text is string
          && request.resource.data.text.size() <= 4000;
      }

      match /botUsage/{doc} { allow read, write: if false; }
    }

    match /oaCache/{doc} { allow read, write: if false; }
  }
}
